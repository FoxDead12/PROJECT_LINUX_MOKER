#!/bin/bash

# =============================================================
# MOKER Kernel Compile Script
# =============================================================

KERNEL_DIR="linux-6.19.9-moker"
THREADS=$(nproc)

# Cores para output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log_info()    { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[OK]${NC} $1"; }
log_warning() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error()   { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

# =============================================================
# Verificações iniciais
# =============================================================

log_info "A usar $THREADS threads para compilação"

if [ ! -d "$KERNEL_DIR" ]; then
    log_error "Diretório $KERNEL_DIR não encontrado! Executa o script na diretoria correta."
fi

# =============================================================
# Entra no diretório do kernel
# =============================================================

cd "$KERNEL_DIR" || log_error "Não foi possível entrar em $KERNEL_DIR"
log_success "Entrou em $KERNEL_DIR"

# =============================================================
# Fixa versão (sem sufixos -dirty, etc)
# =============================================================

export LOCALVERSION=""
export KBUILD_BUILD_VERSION="1"
export KBUILD_BUILD_USER="moker"
export KBUILD_BUILD_HOST="isep"
export KBUILD_BUILD_TIMESTAMP=""

log_info "Versão fixada (sem sufixos automáticos)"

# =============================================================
# Compilação
# =============================================================

log_info "A compilar kernel com $THREADS threads..."
make -j"$THREADS" \
    LOCALVERSION="" \
    LOCALVERSION_AUTO=n

if [ $? -ne 0 ]; then
    log_error "Falha na compilação do kernel!"
fi
log_success "Kernel compilado com sucesso!"

# =============================================================
# Instala módulos
# =============================================================

log_info "A instalar módulos..."
sudo make modules_install

if [ $? -ne 0 ]; then
    log_error "Falha na instalação dos módulos!"
fi
log_success "Módulos instalados!"

# =============================================================
# Instala kernel
# =============================================================

log_info "A instalar kernel..."
sudo make install

if [ $? -ne 0 ]; then
    log_error "Falha na instalação do kernel!"
fi
log_success "Kernel instalado!"

# =============================================================
# Volta à diretoria anterior
# =============================================================

cd ..
log_success "Voltou à diretoria anterior"

# =============================================================
# Atualiza GRUB
# =============================================================

log_info "A atualizar GRUB..."
sudo update-grub2

if [ $? -ne 0 ]; then
    log_warning "update-grub2 falhou, a tentar update-grub..."
    sudo update-grub
    if [ $? -ne 0 ]; then
        log_error "Falha ao atualizar GRUB!"
    fi
fi
log_success "GRUB atualizado!"

# =============================================================
# Fim
# =============================================================

echo ""
echo -e "${GREEN}=============================================${NC}"
echo -e "${GREEN}  Kernel compilado e instalado com sucesso! ${NC}"
echo -e "${GREEN}=============================================${NC}"
echo ""
log_info "Versão instalada: $(cat include/config/kernel.release 2>/dev/null || echo 'ver após reboot')"
log_info "Threads usados: $THREADS"
echo ""
log_warning "Reinicia a VM para usar o novo kernel: sudo reboot"
